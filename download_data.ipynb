   "source": [
    "import yfinance as yf\n",
    "ticker = \"SPY\"\n",
    "data = yf.download(ticker, start=\"2000-01-01\", end=\"2025-12-01\", progress=False, auto_adjust=False)\n",
    "data = data['Adj Close']\n",
    "data.index.name = None\n",
    "data.columns.name = None\n",
    "data.columns = ['price']\n",
    "data.to_csv(f\"data/{ticker}.csv\")"
   ]
  }
 ],
